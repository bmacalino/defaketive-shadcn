# Keep the files exactly as they are on disk: Unix line endings everywhere,
# except Windows command files, which need Windows line endings to run.
* text=auto eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
*.png binary
*.jpg binary
*.ico binary
*.woff2 binary

# backend/ is a byte-for-byte copy of the original app (scripts/sync_backend.py). Git must not change its line
# endings: the review model checks its own files' SHA-256, and the checker's version is worked out from its files.
backend/** -text
*.gz binary
*.onnx binary
*.joblib binary
